{%  extends 'base.html.twig' %}

{% block title %}{{ testName }} :: {{ qualifier }}{% endblock %}

{% block style %}
<style>
    .table {
        border: 1px solid black;
        border-collapse: collapse;
        min-width: 30%;
    }

    .table caption {
        background-color: lightgray;
        border: 1px solid black;
    }

    .table caption .title {
        font-weight: bolder;
    }

    .table caption .qualifier {
        font-style: italic;
    }

    .table tr {
        border: 1px solid black;
        border-collapse: collapse;
    }

    .table td,
    .table th {
        padding: 5px;
    }

    .table tfoot {
        background-color: lightgray;
    }

</style>
{% endblock %}

{% block content %}
<table class="table">
    <caption>
        <p class="title">{{testName}}</p>
        <p class="qualifier">{{ qualifier }}</p>
    </caption>
    <thead>
        <tr>
            <th style="text-align: left">Código</th>
            <th style="text-align: left">Receita</th>
            <th style="text-align: right">Valor</th>
        </tr>
    </thead>
    <tbody>
    {%  for r in rows %}
        <tr>
            <td style="text-align: left">{{ r.natureza_receita }}</td>
            <td style="text-align: left">{{ r.especificacao }}</td>
            <td style="text-align: right">{{ r.arrecadacao_liquida|format_number({fraction_digit: 2}) }}</td>
        </tr>
    {% else %}
        <tr>
            <td colspan="3">Nenhum erro encontrado.</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{%  endblock %}