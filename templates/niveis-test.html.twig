{%  extends 'base.html.twig' %}

{% block title %}{{ testName }} :: {{ qualifier }}{% endblock %}

{% block style %}
<style>
    .table {
        border: 1px solid black;
        border-collapse: collapse;
        min-width: 30%;
    }

    .table caption {
        background-color: lightgray;
        border: 1px solid black;
    }

    .table caption .title {
        font-weight: bolder;
    }

    .table caption .qualifier {
        font-style: italic;
    }

    .table tr {
        border: 1px solid black;
        border-collapse: collapse;
    }

    .table td,
    .table th {
        padding: 5px;
    }

    .table tfoot {
        background-color: lightgray;
    }

</style>
{% endblock %}

{% block content %}
<table class="table">
    <caption>
        <p class="title">{{testName}}</p>
        <p class="qualifier">{{ qualifier }}</p>
    </caption>
    <thead>
        <tr>
            <th style="text-align: left">Radical 1</th>
            <th style="text-align: right">Saldo 1</th>
            <th style="text-align: left">Radical 2</th>
            <th style="text-align: right">Saldo 2</th>
            <th style="text-align: right">Diferença</th>
        </tr>
    </thead>
    <tbody>
    <tr>
        <th style="text-align: right" colspan="6">Diferenças</th>
        <th style="text-align: right">{{ errors }}</th>
    </tr>
    {%  for r in rows %}
        <tr>
            <td style="text-align: left">{{ r.conta1 }}</td>
            <td style="text-align: right">{{ r.saldo1|format_number({fraction_digit: 2}) }}</td>
            <td style="text-align: left">{{ r.conta2 }}</td>
            <td style="text-align: right">{{ r.saldo2|format_number({fraction_digit: 2}) }}</td>
            <td style="text-align: right">{{ r.diferenca|format_number({fraction_digit: 2}) }}</td>
        </tr>
    {% else %}
        <tr>
            <td colspan="5">Sem erros detectados.</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{%  endblock %}